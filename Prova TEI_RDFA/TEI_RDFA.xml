<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="video2html.xsl"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0"
   xmlns:schema="http://schema.org/"
   xmlns:frbroo="http://iflastandards.info/ns/fr/frbr/frbroo/"
   xml:id="video-volterra-2009">
   
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <!-- Opera teatrale come Work -->
            <title xml:id="Work_CU"
               typeof="frbroo:F1_Work"
               property="schema:name">
               Capitano Ulisse
            </title>
            
            <author xml:id="AS"
               typeof="schema:Person"
               property="schema:creator">
               Alberto Savinio
            </author>
            
            <respStmt>
               <resp>Codifica digitale della risorsa video</resp>
               <name>Denise Biasio</name>
            </respStmt>
         </titleStmt>
         
         <publicationStmt>
            <publisher property="schema:publisher">
               Edizione digitale di Capitano Ulisse
            </publisher>
            
            <date property="schema:datePublished"
               when="2025-11-07">
               7 novembre 2025
            </date>
         </publicationStmt>
         
         <sourceDesc>
            <p>
               Questo file descrive una risorsa digitale relativa alla performance teatrale di 
               <title ref="#Work_CU">Capitano Ulisse</title>
               andata in scena al Teatro Romano di Volterra nel 2009 e disponibile in formato video sulla piattaforma Youtube.
            </p>
         </sourceDesc>
      </fileDesc>
      
      <profileDesc>
         <particDesc>
            <listPerson>
               <person xml:id="SM"
                  typeof="schema:Person">
                  <persName property="schema:name">Simone Migliorini</persName>
                  <occupation property="schema:jobTitle">Regista</occupation>
               </person>
               <!--Possibiltà inserimento cast (property schema:performer) e tecnici scenografi e luci (property schema:contributor)-->
            </listPerson>
         </particDesc>
         
         <settingDesc>
            <!-- Performance come F31_Performance che esegue l'opera -->
            <setting xml:id="Perf_Volterra_2009"
               typeof="frbroo:F31_Performance"
               property="frbroo:R80_performed"
               resource="#Work_CU">
               
               <date when="2009-07-28">28 luglio 2009</date>
               <date when="2009-07-29">29 luglio 2009</date>
               
               <placeName ref="https://www.geonames.org/10401264"
                  typeof="schema:Place"
                  property="schema:name">
                  Teatro Romano di Volterra
               </placeName>
            </setting>
         </settingDesc>
      </profileDesc>
   </teiHeader>
   
   <text>
      <body>
         
         <!-- Registrazione video: F26_Recording
              collegata alla performance tramite R81 -->
         <div type="Video_Recording"
            xml:id="Atto1_Parte1"
            typeof="frbroo:F26_Recording"
            property="frbroo:R81_is_recorded_in"
            resource="#Perf_Volterra_2009">
            
            <head>
               Registrazione video della performance di 
               <title ref="#Work_CU">Capitano Ulisse</title>
            </head>
            
            <p>
               <span property="schema:director" resource="#SM">
                  Regia di <persName ref="#SM">Simone Migliorini</persName>.
               </span>
            </p>
            
            <p>
               L’evento si è svolto al 
               <placeName ref="https://www.geonames.org/10401264"
                  typeof="schema:Place"
                  property="schema:name">
                  Teatro Romano di Volterra
               </placeName>
               il 
               <date when="2009-07-28">28 luglio 2009</date>
               e 
               <date when="2009-07-29">29 luglio 2009</date>.
            </p>
            
            <p>
               Link alla registrazione video:
               <ref href="https://www.youtube.com/watch?v=cBRyzjBWw_k&amp;t=24s"
                  property="schema:contentUrl" typeof="schema:VideoObject">
                  Guarda qui
               </ref>
            </p>
            
            <!-- Collegamento all'edizione digitale dell'opera teatrale -->
            <p>
               <ref property="schema:isBasedOn"
                  resource="https://textonstage.github.io/Capitano-Ulisse/Text.html">
                  Basato sull’opera teatrale 
                  <title ref="#Work_CU">Capitano Ulisse</title>.
               </ref>
            </p>
         </div>
         
      </body>
   </text>
</TEI>
